{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/model/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "model is pure: no React"
              },
              {
                "name": "react-dom",
                "message": "model is pure: no React"
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/store",
                  "**/store/**",
                  "**/persistence",
                  "**/persistence/**",
                  "**/components/**",
                  "**/extractor",
                  "**/extractor/**"
                ],
                "message": "model imports nothing app-level"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/persistence/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "persistence only loads/saves model objects"
              },
              {
                "name": "react-dom",
                "message": "persistence only loads/saves model objects"
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/store",
                  "**/store/**",
                  "**/components/**",
                  "**/extractor",
                  "**/extractor/**"
                ],
                "message": "persistence imports only model"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/extractor/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "extractor only turns captures into drafts"
              },
              {
                "name": "react-dom",
                "message": "extractor only turns captures into drafts"
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/store",
                  "**/store/**",
                  "**/persistence",
                  "**/persistence/**",
                  "**/components/**"
                ],
                "message": "extractor imports only model"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/store/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/components/**"
                ],
                "message": "store never imports UI"
              },
              {
                "group": [
                  "**/persistence/*Repo",
                  "**/persistence/*Repo.ts"
                ],
                "message": "store uses the BoardRepository interface; inject concrete repos in main.jsx"
              },
              {
                "group": [
                  "**/extractor/*"
                ],
                "message": "store uses the Extractor interface; inject concrete extractors in main.jsx"
              }
            ],
            "paths": [
              {
                "name": "../persistence",
                "importNames": [
                  "LocalStorageRepo",
                  "MemoryRepo"
                ],
                "message": "store uses the BoardRepository interface; inject concrete repos in main.jsx"
              },
              {
                "name": "../extractor",
                "importNames": [
                  "HttpExtractor"
                ],
                "message": "store uses the Extractor interface; inject concrete extractors in main.jsx"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/**",
        "src/App.jsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/persistence",
                  "**/persistence/**"
                ],
                "message": "components go through the store (useApp/useActions), never persistence"
              },
              {
                "group": [
                  "**/extractor",
                  "**/extractor/**"
                ],
                "message": "components go through the store (useActions().ingestCaptures), never the extractor"
              },
              {
                "group": [
                  "**/store/*",
                  "**/model/*"
                ],
                "message": "import from the layer's index (../store, ../model), not internals"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/**/*.test.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
